<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeamSorting.Views.InputView"
             x:DataType="viewModel:InputViewModel"
             xmlns:viewModel="clr-namespace:TeamSorting.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:lang="clr-namespace:TeamSorting.Lang"
             xmlns:converter="clr-namespace:TeamSorting.Converters"
             xmlns:controls="clr-namespace:TeamSorting.Controls"
             xmlns:models="clr-namespace:TeamSorting.Models"
             KeyDown="InputElement_OnKeyDown">
    <UserControl.Resources>
        <converter:EnumDisplayNameConvertor x:Key="EnumDisplayNameConvertor" />
        <converter:FormattedTextConverter x:Key="FormattedTextConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="controls|MemberListSelection">
            <Setter Property="MaxHeight" Value="300" />
        </Style>
        <Style Selector="Border.ConstraintInvalid">
            <Setter Property="Background" Value="{DynamicResource AppInvalidBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Border Grid.Row="0"
                Padding="8"
                Background="{DynamicResource AppSurfaceBrush}"
                BoxShadow="{DynamicResource AppCardShadow}">
            <DockPanel>
                <Button HorizontalAlignment="Left"
                        DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static lang:Resources.InputView_Data_Button}"
                                   VerticalAlignment="Center" />
                        <i:Icon Value="mdi-chevron-down"
                                FontSize="20"
                                Margin="4,0,0,0" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="{x:Static lang:Resources.InputView_LoadData_Button}"
                                      Click="LoadData_OnClick"
                                      i:MenuItem.Icon="mdi-file-delimited" />
                            <MenuItem Header="{x:Static lang:Resources.InputView_DeleteData_Button}"
                                      Click="DeleteDataButton_OnClick"
                                      i:MenuItem.Icon="mdi-delete" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button HorizontalAlignment="Left"
                        DockPanel.Dock="Left"
                        Margin="5 0 0 0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static lang:Resources.InputView_Add_Button}"
                                   VerticalAlignment="Center" />
                        <i:Icon Value="mdi-chevron-down"
                                FontSize="20"
                                Margin="4,0,0,0" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="{x:Static lang:Resources.InputView_AddMember_MenuItem}"
                                      Click="AddMemberMenuItem_OnClick" />
                            <MenuItem Header="{x:Static lang:Resources.InputView_AddDiscipline_MenuItem}"
                                      Click="AddDisciplineMenuItem_OnClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button DockPanel.Dock="Right"
                        Click="ShowTeamsButton_OnClick"
                        IsEnabled="{Binding CanShowTeams}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.ServiceEnabled="{Binding !CanShowTeams}"
                        ToolTip.Tip="{x:Static lang:Resources.InputView_ConstraintErrors_BlockTeams_ToolTip}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static lang:Resources.InputView_ShowTeams_Button}" />
                        <i:Icon Value="mdi-arrow-right"
                                FontSize="16"
                                Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="8"
                BorderThickness="0"
                CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                BoxShadow="{DynamicResource AppCardShadow}"
                IsVisible="{Binding ShowAddMemberToolbar}"
                Padding="4">
            <DockPanel HorizontalAlignment="Stretch">
                <TextBox Text="{Binding NewMemberName}"
                         Watermark="{x:Static lang:Resources.InputView_NewMember_TextBox_Watermark}"
                         IsVisible="True"
                         Width="200"
                         KeyDown="NewMemberTextBox_OnKeyDown"
                         DockPanel.Dock="Left" />
                <Button DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Margin="4 0 0 0"
                        IsEnabled="{Binding CanAddMember}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.ServiceEnabled="{Binding IsNewMemberNameDuplicate}"
                        ToolTip.Tip="{x:Static lang:Resources.InputView_Member_DuplicateName_Error}"
                        Click="NewMemberTextBox_OnClick"
                        Content="{x:Static lang:Resources.InputView_NewMember_Button}" />
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Click="AddToolbarCloseButton_OnClick"
                        Content="{x:Static lang:Resources.InputView_AddToolbarClose_Button}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="8"
                BorderThickness="0"
                CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                BoxShadow="{DynamicResource AppCardShadow}"
                IsVisible="{Binding ShowAddDisciplineToolbar}"
                Padding="4">
            <DockPanel HorizontalAlignment="Stretch">
                <TextBox Text="{Binding NewDisciplineName}"
                         Watermark="{x:Static lang:Resources.InputView_NewDiscipline_Watermark}"
                         Width="200"
                         KeyDown="AddDisciplineTextBox_OnKeyDown"
                         DockPanel.Dock="Left" />
                <ComboBox ItemsSource="{Binding DisciplineDataTypes}"
                          x:Name="DisciplineTypeComboBox"
                          Margin="4 0 0 0"
                          Loaded="ComboBox_OnLoaded"
                          DockPanel.Dock="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding ., Converter={StaticResource EnumDisplayNameConvertor}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding SortOrder}"
                          x:Name="DisciplineSortOrderComboBox"
                          Margin="4 0 0 0"
                          Loaded="ComboBox_OnLoaded"
                          DockPanel.Dock="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding ., Converter={StaticResource EnumDisplayNameConvertor}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Margin="4 0 0 0"
                        IsEnabled="{Binding CanAddDiscipline}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.ServiceEnabled="{Binding IsNewDisciplineNameDuplicate}"
                        ToolTip.Tip="{x:Static lang:Resources.InputView_DuplicateDiscipline_Error}"
                        Click="AddDisciplineButton_OnClick"
                        Content="{x:Static lang:Resources.InputView_AddDiscipline_Button}" />
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Click="AddToolbarCloseButton_OnClick"
                        Content="{x:Static lang:Resources.InputView_AddToolbarClose_Button}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="8"
                BorderThickness="0"
                CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                BoxShadow="{DynamicResource AppCardShadow}">
            <Border BorderThickness="0"
                    ClipToBounds="True"
                    CornerRadius="{Binding $parent[Border].CornerRadius}">
                <Grid>
                    <Label HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Content="{x:Static lang:Resources.InputView_EmptyInputTable_Label}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                           IsVisible="{Binding MembersEmpty }" />
                    <TreeDataGrid
                        Name="Members"
                        Source="{Binding TreeDataGridSource}"
                        AutoDragDropRows="False"
                        SelectionChanging="Members_OnSelectionChanging">
                        <TreeDataGrid.Resources>
                            <DataTemplate x:Key="MemberNameCell" DataType="models:Member">
                                <controls:ValidationTextBlock ValidatedText="{Binding Name}"
                                                              VerticalAlignment="Center"
                                                              Margin="4,8">
                                </controls:ValidationTextBlock>
                            </DataTemplate>
                            <DataTemplate x:Key="MemberNameCellEdit" DataType="models:Member">
                                <TextBox Text="{Binding Name}"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                            <DataTemplate x:Key="RemoveMemberCell">
                                <Button Click="RemoveMemberButton_OnClick"
                                        ToolTip.Tip="{x:Static lang:Resources.InputView_RemoveMember_Button_Tooltip}"
                                        i:Attached.Icon="mdi-close"
                                        Background="Transparent"
                                        Padding="5" />
                            </DataTemplate>
                            <DataTemplate x:Key="WithCell" DataType="models:Member">
                                <controls:MemberListControl
                                    AllMembers="{Binding $parent[UserControl].((viewModel:InputViewModel)DataContext).Members.SortedMembers}"
                                    CurrentMember="{Binding .}"
                                    SelectedMembers="{Binding With}"
                                    InvalidMembers="{Binding InvalidWithMembers}"
                                    ValidationErrors="{Binding WithConstraintErrors}" />
                            </DataTemplate>
                            <DataTemplate x:Key="NotWithCell" DataType="models:Member">
                                <controls:MemberListControl
                                    AllMembers="{Binding $parent[UserControl].((viewModel:InputViewModel)DataContext).Members.SortedMembers}"
                                    CurrentMember="{Binding .}"
                                    SelectedMembers="{Binding NotWith}"
                                    InvalidMembers="{Binding InvalidNotWithMembers}"
                                    ValidationErrors="{Binding NotWithConstraintErrors}" />
                            </DataTemplate>
                        </TreeDataGrid.Resources>
                        <TreeDataGrid.Styles>
                            <Style Selector="TreeDataGrid TreeDataGridRow:nth-last-child(2n)">
                                <Setter Property="Background" Value="{DynamicResource AppSubtleSurfaceBrush}" />
                            </Style>
                        </TreeDataGrid.Styles>
                    </TreeDataGrid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
